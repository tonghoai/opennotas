{
  "name": "opennotas",
  "version": "1.4.0",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate:sqlite --config=migrate/drizzle/drizzle.config.ts",
    "ui:audit": "node scripts/ui-audit.mjs",
    "patch": "npm version patch",
    "minor": "npm version minor",
    "major": "npm version major",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prod": "NUXT_PUBLIC_ENV=production npm run build && E2E_SERVER=prod playwright test",
    "test:ci": "node scripts/run-all-tests.mjs",
    "test:a11y": "playwright test --grep @a11y",
    "test:pwa": "playwright test --grep @pwa",
    "test:help": "node scripts/run-all-tests.mjs --help",
    "test:all": "node scripts/run-all-tests.mjs"
  },
